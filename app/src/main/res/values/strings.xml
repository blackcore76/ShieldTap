<resources>
    <string name="app_name">ShieldTap</string>
    <string name="app_subtitle">Prevents unintended screen touches</string>
    <string name="accessibility_service_description">Blocks screen touches during calls to prevent accidental video call button presses</string>

    <!-- Main Screen -->
    <string name="usage_guide_button">Usage Guide ></string>
    <string name="usage_guide_title">Usage Guide</string>
    <string name="usage_guide_content">ShieldTap prevents unintended screen touches during phone calls.\n\n■ Accessibility Service\nRequired to display the touch-blocking overlay on screen.\nDoes not read or collect any screen content.\n\n■ Call Detection (Plus)\nDetects call connection and disconnection to automatically enable and disable the blind.\nDoes not access phone numbers or call content.\n\n■ Battery Optimization Exemption\nPrevents some manufacturers (Samsung, etc.) from force-stopping the background service.\n\n■ Privacy\nShieldTap does not collect, store, or transmit any personal information.\nNo internet permission is used.</string>
    <string name="usage_guide_close">Close</string>

